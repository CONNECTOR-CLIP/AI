# Copy this file to .env.local and fill in your key.
# Do not paste real API keys into chat, source files, README, or committed fixtures.
OPENROUTER_API_KEY=

# Optional. The CLI defaults to the OpenRouter latest OpenAI alias used in
# OpenRouter's quickstart; override it if your account/key should use another model.
OPENROUTER_MODEL=~openai/gpt-latest
